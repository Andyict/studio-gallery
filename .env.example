# Name can be changed later without modifying code.
APP_NAME=Studio Gallery
# Để trống để tạo tài khoản quản trị lần đầu trên trang /manager.
ADMIN_PASSWORD=
# Exact public origin, no path. Use HTTPS when sharing outside your LAN.
PUBLIC_ORIGIN=http://192.168.1.10:8088
HTTP_PORT=8088
# Existing NAS directory; mounted read-only.
PHOTO_SOURCE=/volume1/photo/REMINIS_STUDIO
DATA_PATH=/volume1/docker/nas-photo-proofing/data
CACHE_PATH=/volume1/docker/nas-photo-proofing/cache
# NAS user with READ access to PHOTO_SOURCE and WRITE access to DATA_PATH/CACHE_PATH.
PUID=1026
PGID=100
