#!/bin/sh
set -eu
PKG="StudioGallery"
PKG_VAR="/var/packages/$PKG/var"
PKG_TARGET="/var/packages/$PKG/target"
ENV_FILE="$PKG_VAR/.env"
NODE="/var/packages/Node.js_v22/target/usr/local/bin/node"
mkdir -p "$PKG_VAR/logs"

case "${1:-}" in
  start)
    [ -x "$NODE" ] || exit 1
    if [ -f "$PKG_VAR/backend.pid" ] && kill -0 "$(cat "$PKG_VAR/backend.pid")" 2>/dev/null; then exit 0; fi
    set -a; . "$ENV_FILE"; set +a
    export PORT=3211 PHOTO_ROOT="${PHOTO_SOURCE:-/volume1/Studio}" DATA_DIR="$PKG_VAR/data" CACHE_DIR="$PKG_VAR/cache" PUBLIC_ORIGIN="${PUBLIC_ORIGIN:-http://$(hostname -i | awk '{print $1}'):3210}"
    cd "$PKG_TARGET/backend"; nohup "$NODE" src/server.mjs > "$PKG_VAR/logs/backend.log" 2>&1 & echo $! > "$PKG_VAR/backend.pid"
    export HOSTNAME=0.0.0.0 PORT=3210 API_INTERNAL_URL=http://127.0.0.1:3211
    cd "$PKG_TARGET/frontend/frontend"; nohup "$NODE" server.js > "$PKG_VAR/logs/frontend.log" 2>&1 & echo $! > "$PKG_VAR/frontend.pid"
    ;;
  stop)
    for f in backend frontend; do [ -f "$PKG_VAR/$f.pid" ] && kill "$(cat "$PKG_VAR/$f.pid")" 2>/dev/null || true; done
    ;;
  status)
    kill -0 "$(cat "$PKG_VAR/frontend.pid")" 2>/dev/null
    ;;
  *) exit 2 ;;
esac
