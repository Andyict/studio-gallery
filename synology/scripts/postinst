#!/bin/sh
set -eu
. "$(dirname "$0")/common"
mkdir -p "$PKG_VAR/data" "$PKG_VAR/cache" "$PKG_VAR/logs"
if [ ! -f "$ENV_FILE" ]; then
  cat > "$ENV_FILE" <<'EOF'
PHOTO_SOURCE=/volume1/Studio
DATA_PATH=/var/packages/StudioGallery/var/data
CACHE_PATH=/var/packages/StudioGallery/var/cache
# Exact address customers open, e.g. https://gallery.example.com or http://192.168.1.10:3215.
# Leave empty to use the NAS LAN address on port 3215, detected at each start.
PUBLIC_ORIGIN=
APP_NAME="Studio Gallery"
ADMIN_PASSWORD=
EOF
fi
grep -q '^APP_NAME=' "$ENV_FILE" || echo 'APP_NAME="Studio Gallery"' >> "$ENV_FILE"
chmod 600 "$ENV_FILE"
chmod 755 "$PKG_TARGET/ui/api.cgi"
